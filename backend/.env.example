# Copy this file to `.env` and fill in your key. NEVER commit `.env`.
# Get a Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-4-carbon
GEMINI_FLASH_MODEL=gemini-3.8-vision-flash

# Local storage
DB_PATH=./ledgerlens.db
UPLOAD_DIR=./uploads

# Google Cloud Platform (optional — local SQLite/filesystem fallbacks work without these)
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1
DB_BACKEND=sqlite
ALLOYDB_INSTANCE_URI=
BQ_DATASET=ledgerlens_analytics
GCS_UPLOAD_BUCKET=
USE_VERTEX_AI=false
PUBSUB_RECOVERY_TOPIC=
