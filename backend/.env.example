# Copy this file to `.env` and fill in your key. NEVER commit `.env`.
# Get a Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-vision-flash
GEMINI_FLASH_MODEL=gemini-3.8-vision-flash

# Local storage
DB_PATH=./ledgerlens.db
UPLOAD_DIR=./uploads

# Embedded knowledge graph (LadybugDB). The native `lbug` shared library is
# downloaded by `python scripts/setup_lbug_native.py` into <repo>/.cache/ and
# is resolved automatically; pytest always uses :memory:.
LEDGERLENS_GRAPH_ENABLED=true
LEDGERLENS_GRAPH_PATH=./data/ledgerlens.lbdb
LEDGERLENS_GRAPH_BUFFER_POOL_MB=256

# Google Cloud Platform (optional — local SQLite/filesystem fallbacks work without these)
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1
DB_BACKEND=sqlite
ALLOYDB_INSTANCE_URI=
BQ_DATASET=ledgerlens_analytics
GCS_UPLOAD_BUCKET=
USE_VERTEX_AI=false
PUBSUB_RECOVERY_TOPIC=
